APP_ENV=development
POSTGRES_DB=ivm
POSTGRES_USER=ivm
POSTGRES_PASSWORD=ivm_local_only
SECRET_KEY=replace-with-a-long-random-local-demo-secret
DATABASE_URL=postgresql+psycopg://ivm:ivm_local_only@localhost:5432/ivm
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MFA_REQUIRED=false
# Requests per minute per client. Raise LOGIN_RATE_LIMIT only for automated browser test runs.
LOGIN_RATE_LIMIT=10
AI_RATE_LIMIT=20
# HMAC key for the ticketing webhook (leave empty to disable the webhook).
INTEGRATION_WEBHOOK_SECRET=
# Set false on extra API replicas; run exactly one scheduler.
SCHEDULER_ENABLED=true
